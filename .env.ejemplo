# ============================================================
#  Configuración de novia_AI
#  Copia este archivo como .env y rellena tus valores.
#  El archivo .env nunca se sube al repositorio (ver .gitignore).
# ============================================================

# ------------------------------------------------------------
# Proveedor LLM — descomenta el bloque que vayas a usar
# ------------------------------------------------------------

# ── Gemini (Google) ──────────────────────────────────────────
# PROVEEDOR=gemini
# GEMINI_API_KEY=AIza...
# NOVIA_MODELO=gemini-2.5-flash-lite-preview

# ── OpenAI ───────────────────────────────────────────────────
# PROVEEDOR=openai
# OPENAI_API_KEY=sk-...
# NOVIA_MODELO=gpt-4o-mini

# ── Compatible OpenAI (Ollama, LM Studio, OpenRouter, etc.) ──
# PROVEEDOR=openai
# OPENAI_API_KEY=ollama          # algunos servidores locales no requieren clave real
# NOVIA_URL_BASE=http://localhost:11434/v1
# NOVIA_MODELO=llama3.2

# ── Sin LLM — modo desarrollo (respuestas ficticias) ─────────
# PROVEEDOR=stub

# ------------------------------------------------------------
# Opciones generales
# ------------------------------------------------------------

# Ruta al directorio de datos (por defecto: ./data)
# NOVIA_DATOS=./data
